rules_version = '2';
service cloud.firestore {

// ============================================================================
// Firestore 보안 규칙 (2026-10-15 재작성)
//
// 배경: 목록(LIST) 쿼리에서는 문서마다 달라지는 경로로 get()/exists()를 호출하면 규칙이
// "Missing or insufficient permissions"로 실패합니다(단일 문서 조회/쓰기는 영향 없음).
// 그래서 읽기 규칙은 아래 두 가지만 사용합니다.
//   (1) 문서 자체 필드: member_uids / assignee_user_ids / assignee_user_id / questioner_user_id
//   (2) 로그인 토큰 클레임: org_role (서버가 src/lib/firebase/userClaims.ts 로 설정)
// 쓰기(create/update/delete)는 단일 문서 평가라 permissions 문서를 get()/exists()로 확인해도 됩니다.
//
// 권한 체계: SUPER_ADMIN(전체 기능+전체 열람) / ADMIN(전체 열람만) / USER(회의록 단위 권한)
// 회의록 단위 권한: meetings/{id}/permissions/{uid}.role = AUTHOR / PARTICIPANT / VIEWER
// meetings.member_uids 는 permissions 서브컬렉션과 함께 서버(meetingAccess.ts)가 동기화합니다.
// ============================================================================

match /databases/{database}/documents {

  // ---- 공통 함수 (db match 블록 안에 두어야 $(database) 변수를 쓸 수 있습니다) ----
  function isSignedIn() {
    return request.auth != null;
  }

  // ---- 토큰 클레임 기반 (LIST 규칙에서도 안전) ----
  function claimRole() {
    return request.auth.token.get('org_role', '');
  }

  function claimOrg() {
    return request.auth.token.get('organization_id', '');
  }

  // 관리 기능(인원관리 등) — SUPER_ADMIN만
  function isOrgAdmin() {
    return isSignedIn() && claimRole() == 'SUPER_ADMIN';
  }

  // 전체 컨텐츠 열람 — SUPER_ADMIN, ADMIN
  function canViewAllContent() {
    return isSignedIn() && claimRole() in ['SUPER_ADMIN', 'ADMIN'];
  }

  // ---- 단일 문서 쓰기/조회에서만 사용 (LIST 규칙에서는 쓰지 말 것) ----
  // 클레임이 아직 없는 계정을 위해 users 문서도 함께 확인합니다.
  function isSuperAdmin() {
    return isOrgAdmin() ||
      (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.org_role == 'SUPER_ADMIN');
  }

  function hasMeetingPermissionDoc(meetingId) {
    return exists(/databases/$(database)/documents/meetings/$(meetingId)/permissions/$(request.auth.uid));
  }

  function meetingPermission(meetingId) {
    return get(/databases/$(database)/documents/meetings/$(meetingId)/permissions/$(request.auth.uid)).data;
  }

  // 토큰 클레임(관리자) 확인을 먼저 하고, 아니면 permissions 문서 존재 여부를 봅니다.
  function hasMeetingAccess(meetingId) {
    return isSignedIn() && (canViewAllContent() || hasMeetingPermissionDoc(meetingId));
  }

  function meetingRoleIn(meetingId, roles) {
    return isSignedIn() && hasMeetingPermissionDoc(meetingId) && meetingPermission(meetingId).role in roles;
  }

  // 편집: 편집자(AUTHOR)/참여자(PARTICIPANT) 또는 SUPER_ADMIN
  function canEditMeeting(meetingId) {
    return meetingRoleIn(meetingId, ['AUTHOR', 'PARTICIPANT']) || isSuperAdmin();
  }

  // 삭제 등 강한 권한: 편집자(AUTHOR) 또는 SUPER_ADMIN
  function isMeetingAuthor(meetingId) {
    return meetingRoleIn(meetingId, ['AUTHOR']) || isSuperAdmin();
  }



  // ---- 조직 / 부서 : 쓰기는 서버(Admin SDK)만 ----
  match /organizations/{orgId} {
    allow read: if isSignedIn();
    allow write: if false;
  }

  match /departments/{deptId} {
    allow read: if isSignedIn() &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organization_id == resource.data.organization_id;
    allow write: if false;
  }

  // ---- 사용자 프로필: 같은 회사 구성원 조회 가능, 쓰기는 서버 전용 ----
  match /users/{uid} {
    allow read: if isSignedIn() &&
      (request.auth.uid == uid ||
       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organization_id == resource.data.organization_id);
    allow write: if false;
  }

  // ---- 프로젝트 ----
  match /projects/{projectId} {
    allow read: if isSignedIn() &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organization_id == resource.data.organization_id;
    allow create: if isSignedIn() &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organization_id == request.resource.data.organization_id;
    allow update, delete: if isSignedIn() &&
      (isSuperAdmin() ||
       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organization_id == resource.data.organization_id);
  }

  // ---- 회의 ----
  match /meetings/{meetingId} {
    // LIST 안전: 문서 자신의 member_uids 또는 토큰 클레임만 사용
    allow read: if isSignedIn() &&
      (request.auth.uid in resource.data.get('member_uids', []) || canViewAllContent());

    allow create: if isSignedIn() &&
      request.auth.uid in request.resource.data.member_uids &&
      (claimOrg() == request.resource.data.organization_id ||
       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organization_id == request.resource.data.organization_id);

    // member_uids는 서버(Admin SDK)가 permissions와 함께 갱신 — 클라이언트 update로는 건드릴 수 없음
    allow update: if canEditMeeting(meetingId) &&
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['member_uids']);

    allow delete: if isMeetingAuthor(meetingId);

    // 아래 서브컬렉션은 항상 부모 회의 하나 밑에서만 조회되므로 exists()/get()을 써도 안전
    match /participants/{userId} {
      allow read: if hasMeetingAccess(meetingId);
      allow write: if canEditMeeting(meetingId);
    }

    // 권한 문서: 편집자만 관리. 회의 생성 직후 본인을 AUTHOR로 최초 등록하는 것만 예외 허용.
    match /permissions/{userId} {
      allow read: if hasMeetingAccess(meetingId);
      allow create: if isSignedIn() &&
        ((userId == request.auth.uid && request.resource.data.role == 'AUTHOR' &&
          !exists(/databases/$(database)/documents/meetings/$(meetingId)/permissions/$(request.auth.uid)))
         || isMeetingAuthor(meetingId));
      allow update, delete: if isMeetingAuthor(meetingId);
    }

    // 공유 설정(열람자 발급): 편집자만
    match /shares/{shareId} {
      allow read, write: if isMeetingAuthor(meetingId);
    }
  }

  // meetingSummaries는 항상 meeting_id를 문서 id로 직접 getDoc (목록 조회 없음)
  match /meetingSummaries/{meetingId} {
    allow read: if hasMeetingAccess(meetingId);
    allow write: if canEditMeeting(meetingId);
  }

  // ---- 질의(문답) ----
  match /questions/{questionId} {
    allow read: if isSignedIn() &&
      (resource.data.get('assignee_user_id', '') == request.auth.uid ||
       resource.data.get('questioner_user_id', '') == request.auth.uid ||
       request.auth.uid in resource.data.get('member_uids', []) ||
       canViewAllContent());
    allow create: if hasMeetingAccess(request.resource.data.meeting_id);
    allow update: if canEditMeeting(resource.data.meeting_id) ||
      (isSignedIn() && resource.data.get('assignee_user_id', '') == request.auth.uid);
    allow delete: if isMeetingAuthor(resource.data.meeting_id);

    // 답변은 항상 questions/{id}/answers 로 부모가 고정된 쿼리
    match /answers/{answerId} {
      allow read: if hasMeetingAccess(get(/databases/$(database)/documents/questions/$(questionId)).data.meeting_id);
      allow create: if hasMeetingAccess(request.resource.data.source_meeting_id);
      allow update, delete: if isSignedIn() && resource.data.answerer_user_id == request.auth.uid;
    }
  }

  // ---- 결정 사항 (이력은 append-only) ----
  match /decisions/{decisionId} {
    allow read: if isSignedIn() &&
      (request.auth.uid in resource.data.get('member_uids', []) || canViewAllContent());
    allow create: if canEditMeeting(request.resource.data.meeting_id);
    allow update: if canEditMeeting(resource.data.meeting_id);
    // 2026-10-15: "삭제" 버튼 추가에 맞춰 편집자(AUTHOR)/SUPER_ADMIN에 한해 삭제 허용.
    // 변경 이력(history)은 append-only 유지.
    allow delete: if isMeetingAuthor(resource.data.meeting_id);

    match /history/{historyId} {
      allow read: if hasMeetingAccess(get(/databases/$(database)/documents/decisions/$(decisionId)).data.meeting_id);
      allow create: if canEditMeeting(request.resource.data.meeting_id);
      allow update, delete: if false;
    }
  }

  // ---- 향후추진과제 (ActionItem) ----
  match /actionItems/{itemId} {
    allow read: if isSignedIn() &&
      (request.auth.uid in resource.data.get('assignee_user_ids', []) ||
       request.auth.uid in resource.data.get('member_uids', []) ||
       canViewAllContent());
    allow create: if canEditMeeting(request.resource.data.meeting_id);
    allow update: if canEditMeeting(resource.data.meeting_id) ||
      (isSignedIn() && request.auth.uid in resource.data.get('assignee_user_ids', []));
    allow delete: if isMeetingAuthor(resource.data.meeting_id);
  }

  // ---- 회의 간 연결 ----
  match /meetingRelations/{relationId} {
    allow read: if isSignedIn() &&
      (request.auth.uid in resource.data.get('member_uids', []) || canViewAllContent());
    allow create: if canEditMeeting(request.resource.data.child_meeting_id);
    allow update, delete: if canEditMeeting(resource.data.child_meeting_id);
  }

  // ---- 공유 접근 로그: 서버 전용 ----
  match /meetingShareAccessLogs/{logId} {
    allow read, write: if false;
  }

  // ---- 그로스잇 브랜드 정기 성과 리포트 자동화 (서버 API(Admin SDK)로만 접근) ----
  match /brands/{brandId} {
    allow read, write: if false;
  }

  match /brandCredentials/{brandId} {
    allow read, write: if false;
  }

  match /brandMonthlyData/{docId} {
    allow read, write: if false;
  }

  match /reportPublishHistory/{historyId} {
    allow read, write: if false;
  }

  match /brandMonthlyMembers/{docId} {
    allow read, write: if false;
  }
}
}
