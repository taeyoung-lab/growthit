# ============================================================
# Firebase 클라이언트 설정값
# Firebase 콘솔 > 프로젝트 설정 > 일반 > "내 앱"(웹 앱) 에서 확인
# 이 값들은 브라우저에 노출되어도 되는 공개 설정값입니다 (비밀키 아님)
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# Firebase Admin SDK (서버 전용, 절대 커밋/공유 금지)
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은
# JSON 파일의 내용을 한 줄로 이스케이프해서 넣거나, 아래 3개 필드로 분리해 넣으세요.
# ============================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ============================================================
# 회의 공유 링크에 사용할 기본 도메인 (서버 API 라우트 전용 — 브라우저에 노출 불필요)
# ============================================================
APP_BASE_URL=http://localhost:3000
